# ---------------------------------------------------------------------------
# BloodLink environment template.
# Copy this file to ".env" and adjust the values. ".env" is git-ignored.
# ---------------------------------------------------------------------------

# --- PostgreSQL container (read by docker-compose.yml) ---------------------
POSTGRES_USER=bloodlink
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bloodlink
# Host port mapped to the container's 5432. 5433 avoids clashing with any
# PostgreSQL server already installed on the machine. Use this port in pgAdmin 4.
POSTGRES_PORT=5433

# --- API settings (read by backend/app/core/config.py) ---------------------
ENVIRONMENT=development
# Must match the credentials and port above.
DATABASE_URL=postgresql+psycopg://bloodlink:change-me@localhost:5433/bloodlink
# Generate a real value with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-long-random-string-before-deploying
# JSON list of browser origins allowed to call the API.
CORS_ORIGINS=["http://localhost:3000"]

# --- Demonstration data (read only by: uv run python -m scripts.seed_demo) ---
# Every demonstration account (admin@bloodlink.example, staff.lagos@bloodlink.example,
# donor01@bloodlink.example, ...) signs in with this password. Use a different value
# for any deployed demonstration.
DEMO_PASSWORD=crimson-harbour-lantern-47
# Optional: your own phone number, given to donor01 so you can receive test alerts.
# Leave empty to give no demonstration donor a phone number.
DEMO_DONOR_PHONE=

# --- Text-message alerts -----------------------------------------------------
# Address of the web app, used in the link sent to donors.
FRONTEND_URL=http://localhost:3000
# "console" records alerts and writes them to the API log without sending (free,
# the default). "termii" sends real, paid messages; Termii has no sandbox.
# Termii is only used when the key, base URL and a valid sender ID are all set;
# otherwise the API falls back to "console" and logs a warning.
SMS_PROVIDER=console
# From the Termii dashboard: Settings > API Token. Keep the key secret.
TERMII_API_KEY=
TERMII_BASE_URL=
# Your approved sender ID: 3 to 11 letters or digits, for example BloodLink.
TERMII_SENDER_ID=
# "dnd" reaches Do-Not-Disturb numbers at any hour (ask Termii support to enable
# it); "generic" is the promotional route, blocked on MTN between 8 PM and 8 AM.
TERMII_CHANNEL=dnd
